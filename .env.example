# Скопируйте в .env и при необходимости измените.
# Все переменные необязательны — значения по умолчанию берутся из config/app.yaml.

# Метка точки наблюдения: local | github-runner | ru-vds | ...
IPTV_PROBE_LOCATION=local

# Каталоги конфигурации, данных и результатов
IPTV_CONFIG_DIR=config
IPTV_DATA_DIR=data
IPTV_DIST_DIR=dist

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
IPTV_LOG_LEVEL=INFO

# Хранилище истории проверок: jsonl | sqlite
IPTV_STORAGE=jsonl
IPTV_JSONL_PATH=data/state/checks.jsonl
IPTV_SQLITE_PATH=data/state/history.sqlite

# Путь к ffprobe (для уровня медиапроверки)
IPTV_FFPROBE_BIN=ffprobe
