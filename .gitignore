# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env

# Generated artifacts
dist/
# Локальные рабочие каталоги scripts/merge_history.sh (результаты слияния
# живут в CI-артефактах и ветках probe/ru, history/global — не в git).
artifacts/
probe/
deploy/vds/data/state/*.jsonl

# Runtime data (keep directory placeholders)
data/cache/*
!data/cache/.gitkeep
data/state/*
!data/state/.gitkeep
# Подтверждённые к публикации потоки — единственный трекаемый файл состояния
# (сборка в CI должна его видеть).
!data/state/approved_streams.yaml

# VDS check results (local emulation and real runs)
deploy/vds/data/

# OS
.DS_Store
Thumbs.db
